{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "vendor/edmonds-blossom/{index.cjs,LICENSE,README.md}",
        "outDir": "dist/src"
      },
      {
        "include": "scripts/**/*.ts",
        "outDir": "dist"
      }
    ]
  }
}
